---
import {Image} from "astro:assets";
import elevenWindows from "@assets/images/eleven_windows_v2.png";
import {EXTERNAL_URL} from "@utils/url";
import {Icon} from "astro-icon/components";

type Props = {
	showHeader?: boolean;
};

const {showHeader = true} = Astro.props;
---

<section>
	<div class="projectsContainer">
		<div class="project">
			{
				showHeader && (
					<a href="/projects" class="link projectsLink">
						<h2
							id="projectsTitle"
							class="title"
							data-content="Projects"
						>
							Projects
						</h2>
					</a>
				)
			}
			<div class="info">
				<p>
					<a
						href={EXTERNAL_URL.ELEVEN_WINDOWS.URL}
						aria-label={EXTERNAL_URL.ELEVEN_WINDOWS.ARIA_LABEL}
						title={EXTERNAL_URL.ELEVEN_WINDOWS.TITLE}
						target="_blank"
						class="link projectLink"
					>
						<span> ElevenWindows.dev </span>
						<Icon
							title="ElevenWindows.dev "
							name="ri:external-link-line"
							width={20}
							height={20}
						/>
					</a>
					It's a clone of the Windows OS, built with React, JavaScript,
					CSS, and Styled Components.
				</p>
				<p>
					Key features include full responsiveness, with an
					Android-inspired theme on mobile devices.
				</p>
			</div>

			<a
				class="projectImage"
				href={EXTERNAL_URL.ELEVEN_WINDOWS.URL}
				aria-label={EXTERNAL_URL.ELEVEN_WINDOWS.ARIA_LABEL}
				title={EXTERNAL_URL.ELEVEN_WINDOWS.TITLE}
				target="_blank"
			>
				<div class="projectYear">2021</div>
				<Image
					class="img"
					src={elevenWindows}
					alt={"windows 11"}
					loading="lazy"
					decoding="sync"
				/>
			</a>
		</div>
	</div>
</section>

<style>
	#projectsTitle {
		transition: all 0.2s;
	}
	.projectYear {
		position: absolute;
		left: -5px;
		top: 1rem;
		z-index: var(--zIndex_1);
		width: 4.5rem;
		padding: 0.2rem;
		text-align: center;
		letter-spacing: 2px;
		font-weight: 600;
		color: var(--dark_blue_200);
		background-color: var(--light_blue_100);
		border-top-right-radius: 0.2rem;
		border-bottom-right-radius: 0.2rem;
		overflow: unset;
	}

	.projectYear::before {
		content: "";
		position: absolute;
		bottom: -5px;
		left: 0;
		width: 0;
		height: 0;
		border-style: solid;
		border-width: 0 5px 5px 0;
		border-color: transparent var(--dark_blue_900) transparent transparent;
	}

	section {
		width: 100%;
	}

	.projectLink {
		display: inline-flex;
		gap: 0.25rem;

		svg {
			display: inline-block;
			vertical-align: middle;
			transform: scale(0.8);
			transition: transform 0.1s;
		}
	}

	.projectLink:hover svg {
		transform: scale(1) translate3d(0.125rem, -0.125rem, 0);
	}

	.projectsLink {
		margin-bottom: 2rem;
	}

	.projectsLink:not(:hover, :focus, :active) {
		color: inherit;
	}

	.title {
		padding: 1rem 0;
		font-size: 2rem;
	}

	.project {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	.info {
		margin-bottom: 2rem;
	}

	.info p {
		text-align: center;
	}

	.projectsContainer {
		display: flex;
		justify-content: center;
		align-items: center;
		max-width: 80rem;
		width: 100%;
		margin: 0 auto;
		padding: 6rem 1rem 0 1rem;
	}

	.projectImage {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
		width: fit-content;
		border-radius: 1rem;
		background-image: linear-gradient(
			to bottom left,
			var(--light_blue_100),
			var(--light_blue_100_transparent_30),
			var(--light_blue_100)
		);
	}
	.projectImage::before {
		content: "";
		position: absolute;
		left: 0;
		bottom: 0;
		width: 40%;
		height: 70%;
		filter: blur(70px);
		z-index: var(--zIndex_behind_1);
		background: var(--light_blue_100);
	}
	.projectImage::after {
		content: "";
		position: absolute;
		right: 0;
		top: 0;
		width: 40%;
		height: 70%;
		filter: blur(70px);
		z-index: var(--zIndex_behind_1);
		background: var(--light_blue_100);
	}

	.projectImage .img {
		border-radius: inherit;
		height: auto;
		width: calc(100% - 2px);
		max-width: 50rem;
		padding: 0.5rem;
	}
</style>
